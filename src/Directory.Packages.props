<Project>

	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup Label="Build and versioning">
		<PackageVersion Include="Nerdbank.GitVersioning" Version="3.9.50" />
		<PackageVersion Include="Meziantou.Analyzer" Version="2.0.299" />
		<PackageVersion Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.14.15" />
	</ItemGroup>

	<ItemGroup Label="Runtime dependencies">
		<PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="9.0.4" />
		<PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.5" />
		<PackageVersion Include="ModelContextProtocol" Version="1.4.1" />
		<PackageVersion Include="Repl" Version="0.11.0" />
		<PackageVersion Include="Repl.Mcp" Version="0.11.0" />
		<PackageVersion Include="Repl.Testing" Version="0.11.0" />
		<PackageVersion Include="System.Text.Json" Version="9.0.4" />
	</ItemGroup>

	<ItemGroup Label="Test dependencies">
		<PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.1.0" />
		<PackageVersion Include="AwesomeAssertions" Version="9.3.0" />
	</ItemGroup>

</Project>
